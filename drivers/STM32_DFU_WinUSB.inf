[Strings]
ProviderName="ImpulseRC"
ManufacturerName="STMicroelectronics"
ClassName="Universal Serial Bus devices"
ClassGuid="{36FC9E60-C465-11CF-8056-444553540000}"
DiskName="STM32 DFU Driver Installation Disk"

DeviceNameDFU="STM32 DFU Bootloader"

[DefaultInstall]
CopyINF=STM32_DFU_WinUSB.inf

[DefaultInstall.Services]
AddService=WinUSB,0,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName="WinUSB Driver"
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WinUSB.sys

[DefaultUninstall]
RemoveInF=STM32_DFU_WinUSB.inf

[DefaultUninstall.Services]
DelService=WinUSB,0x00000200

[Manufacturer]
%ManufacturerName%=DriverInstall,NT,NTx86,NTamd64,NTarm

[DriverInstall.NT]
%DeviceNameDFU%=USB_Install,USB\VID_0483&PID_DF11

[DriverInstall.NTx86]
%DeviceNameDFU%=USB_Install,USB\VID_0483&PID_DF11

[DriverInstall.NTamd64]
%DeviceNameDFU%=USB_Install,USB\VID_0483&PID_DF11

[DriverInstall.NTarm]
%DeviceNameDFU%=USB_Install,USB\VID_0483&PID_DF11

[USB_Install.NT]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.NTx86]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.NTamd64]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.NTarm]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.NT.Services]
AddService=WinUSB,0,WinUSB_ServiceInstall

[USB_Install.NTx86.Services]
AddService=WinUSB,0,WinUSB_ServiceInstall

[USB_Install.NTamd64.Services]
AddService=WinUSB,0,WinUSB_ServiceInstall

[USB_Install.NTarm.Services]
AddService=WinUSB,0,WinUSB_ServiceInstall

[USB_Install.NT.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[USB_Install.NTx86.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[USB_Install.NTamd64.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[USB_Install.NTarm.CoInstallers]
AddReg=CoInstallers_AddReg
CopyFiles=CoInstallers_CopyFiles

[CoInstallers_AddReg]
HKR,,CoInstallers32,0x00010000,"WinUSBCoInstaller2.dll"

[CoInstallers_CopyFiles]
WinUSBCoInstaller2.dll

[DestinationDirs]
CoInstallers_CopyFiles=11

[SourceDisksNames]
1="WinUSB CoInstaller"

[SourceDisksFiles.x86]
WinUSBCoInstaller2.dll=1

[SourceDisksFiles.amd64]
WinUSBCoInstaller2.dll=1

[SourceDisksFiles.arm]
WinUSBCoInstaller2.dll=1
